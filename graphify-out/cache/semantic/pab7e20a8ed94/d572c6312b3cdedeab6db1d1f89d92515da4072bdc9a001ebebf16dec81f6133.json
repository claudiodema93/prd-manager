{"nodes": [{"id": "readme_prdmanager", "label": "PrdManager", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_sqlite_cache", "label": "SQLite Cache in userData", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The app keeps a SQLite cache in the Electron userData directory (cache.db) managed with Drizzle ORM and better-sqlite3 in the main process. It is deliberately treated as a disposable cache rather than a source of truth, which permits aggressive self-repair on startup."}, {"id": "readme_cache_corruption_recovery", "label": "Cache Corruption Recovery Policy", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A damaged cache file is reset in place (tables dropped and migrations re-applied) or, when that is not possible, moved aside as cache.db.corrupt-<timestamp>. The file is never deleted and non-SQLite files are never modified, so the app cannot destroy user data it does not own."}, {"id": "readme_application_id_sentinel", "label": "application_id Sentinel", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An application_id sentinel prevents the app from touching another application's SQLite database, guarding the reset/migration path against being pointed at a foreign file."}, {"id": "readme_drizzle_orm", "label": "Drizzle ORM with better-sqlite3", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_orpc_ipc_boundary", "label": "oRPC Renderer Boundary", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Database rows are exposed to the renderer only through oRPC procedures (src/ipc/customers -> src/actions/customers.ts), keeping SQLite and Drizzle confined to the main process and preserving the sandboxed renderer."}, {"id": "readme_electron_sandbox", "label": "Electron Renderer Sandbox", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Project preference: context isolation on, nodeIntegration false, and Electron's sandbox enabled, so the renderer has no direct Node or filesystem access and must go through IPC."}, {"id": "readme_auto_update", "label": "GitHub Releases Auto Update", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_github_actions_ci", "label": "GitHub Actions CI/CD and Releases", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_react_compiler", "label": "React Compiler Enabled by Default", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "React Compiler is enabled by default so components do not need manual memoization; automatic optimization is the project's stated preference."}], "edges": [{"source": "readme_prdmanager", "target": "readme_sqlite_cache", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_sqlite_cache", "target": "readme_drizzle_orm", "relation": "references", "confidence": "EXTRACTED"