{"nodes": [{"id": "_github_copilot_instructions_ultracite", "label": "Ultracite Code Standards", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Zero-config preset chosen to enforce strict, automated code quality so review effort can focus on business logic, naming, architecture, edge cases and UX instead of formatting."}, {"id": "_github_copilot_instructions_biome", "label": "Biome (Underlying Lint/Format Engine)", "file_type": "concept", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_github_copilot_instructions_type_safety", "label": "Type Safety & Explicitness", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prefer unknown over any, const assertions, type narrowing and named constants so intent is explicit and compiler-checked rather than asserted."}, {"id": "_github_copilot_instructions_modern_js_ts", "label": "Modern JavaScript/TypeScript Practices", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Arrow functions, for...of, optional chaining, nullish coalescing, template literals, destructuring and const-by-default favor clarity over brevity."}, {"id": "_github_copilot_instructions_async_promises", "label": "Async & Promises Guidelines", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "async/await with awaited return values and meaningful try-catch gives more readable and correct asynchronous code than promise chains."}, {"id": "_github_copilot_instructions_react_jsx", "label": "React & JSX Guidelines", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Function components, top-level hooks, stable keys, semantic HTML and correct dependencies keep components predictable and accessible."}, {"id": "_github_copilot_instructions_error_handling", "label": "Error Handling & Debugging", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Throw descriptive Error objects, avoid catch-and-rethrow and remove console/debugger/alert from production so failures stay actionable."}, {"id": "_github_copilot_instructions_code_organization", "label": "Code Organization", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Focused functions, named boolean conditions and early returns reduce cognitive complexity and nesting."}, {"id": "_github_copilot_instructions_security", "label": "Security Guidelines", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid eval, document.cookie assignment and unnecessary dangerouslySetInnerHTML; add rel=noopener to target=_blank links and sanitize user input."}, {"id": "_github_copilot_instructions_performance", "label": "Performance Guidelines", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoid spread accumulators in loops, hoist regex literals, use specific imports, avoid barrel files and prefer optimized image components."}, {"id": "_github_copilot_instructions_accessibility", "label": "Accessibility (Semantic HTML & ARIA)", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Meaningful alt text, heading hierarchy, labeled inputs, keyboard handlers and semantic elements instead of divs with roles."}, {"id": "_github_copilot_instructions_testing", "label": "Testing Standards", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Assertions inside it()/test(), async/await instead of done callbacks, no committed .only/.skip and flat suites for readable tests."}, {"id": "_github_copilot_instructions_framework_guidance", "label": "Framework-Specific Guidance", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-framework idioms (Next.js Image/metadata/Server Components, React 19 ref-as-prop, class/for attributes in Solid/Svelte/Vue/Qwik) prevent framework anti-patterns."}, {"id": "_github_copilot_instructions_business_logic", "label": "Business Logic Correctness Beyond Biome", "file_type": "rationale", "source_file": ".github/copilot-instructions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Automated linting cannot validate algorithms, naming, architecture, edge cases, UX or documentation, so human attention is directed there."}], "edges": [{"source": "_github_copilot_instructions_ultracite", "target": "_github_copilot_instructions_biome", "relation": "references", "confidence": "EXTRACTED", 